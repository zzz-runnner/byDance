{
  "name": "agenthub-local",
  "private": true,
  "type": "module",
  "scripts": {
    "chat": "tsx src/cli/chat.ts",
    "chat:new": "tsx src/cli/chat.ts --new-workspace",
    "codex:bridge": "node scripts/start-codex-bridge.js",
    "dev:api": "tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:watch": "vitest tests/unit tests/integration",
    "test:real": "vitest run tests/real",
    "verify": "npm run check && npm test",
    "db:init": "tsx src/server/db/init.ts",
    "db:smoke": "tsx scripts/postgres-smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "fastify": "^5.3.3",
    "fflate": "^0.8.3",
    "pg": "^8.16.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  }
}
